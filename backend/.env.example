# JOURNEYS Backend — Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=5050
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/journeys

# JWT
JWT_SECRET=your-jwt-secret-change-this-in-production

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:5050/api/auth/google/callback

# Google Maps / Routes API
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
GOOGLE_MAPS_BROWSER_KEY=your-browser-restricted-google-maps-key

# LLM API Keys
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
EMAIL_FROM=noreply@journeys.app

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:5180

# Rate limits
API_RATE_LIMIT_MAX=300
GENERATION_RATE_LIMIT_MAX=5

# Price alert scheduler
PRICE_ALERT_CRON=0 */6 * * *

# Fare estimate defaults
CAB_BASE_FARE=50
CAB_PER_KM_FARE=14
BUS_NON_AC_PER_KM=1.5
BUS_AC_PER_KM=2.5
FLIGHT_BASE_FARE=2500
FLIGHT_PER_KM=4.5
